# Copy to .env.local (git-ignored) and fill in. Every line is optional.

# Local model, tried first. Setting the model name turns it on.
LOCAL_LLM_MODEL=gemma3:latest
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_TIMEOUT_SEC=90

# Cloud fallbacks, used when the local model fails or is not running.
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ---- limits and tuning (all optional) ----
# Ceiling on DeepSeek spending for the pets' thinking and speech, in US dollars (default 1).
# It is an estimate from token counts and is kept across saves. The Teacher is not limited by it.
# DEEPSEEK_BUDGET_USD=1

# The local model works through one request at a time; extra calls go to the next provider (default 1).
# LOCAL_LLM_CONCURRENCY=1

# Teacher: simulated minutes between reviews (default 180 = 3 hours), the real-time gap enforced between
# reviews at fast speeds, and a guard on model calls per real hour (a call count, not a dollar limit).
# TEACHER_REVIEW_SIM_MIN=180
# TEACHER_REVIEW_MIN_REAL_SEC=600
# TEACHER_MAX_CALLS_PER_HOUR=30
